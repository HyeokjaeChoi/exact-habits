test "no habits shows the empty state; its button opens the add sheet and Cancel closes it"
  clock data
  expect tree has "empty-add"
  expect tree has "quick-Read"
  expect tree has "quick-Drink Water"
  expect tree has "quick-Journal"
  expect tree missing "progress"
  expect tree missing "progress-bar"
  tap "empty-add"
  clock settle
  expect tree has "add-name"
  tap "add-cancel"
  clock settle
  expect tree missing "add-name"
  expect tree has "empty-add"

test "a name is required; adding Read shows the row, its progress and no streak"
  clock data
  tap "empty-add"
  clock settle
  expect disabled "add-save"
  expect text "add-hint" == "Enter a name to save."
  type "add-name" "Read"
  expect enabled "add-save"
  expect text "add-hint" == ""
  tap "add-save"
  clock data
  clock settle
  expect tree missing "add-name"
  expect text "name-1" == "Read"
  expect text "progress" == "0 of 1 done"
  expect tree has "progress-bar"
  expect tree missing "streak-1"
  expect tree missing "empty-add"

test "a duplicate name is refused, case-insensitively, and the sheet stays open"
  clock data
  tap "empty-add"
  clock settle
  type "add-name" "Read"
  tap "add-save"
  clock data
  clock settle
  tap "add-habit"
  clock settle
  expect tree missing "add-error"
  type "add-name" "read"
  tap "add-save"
  clock data
  expect text "add-error" == "A habit called Read already exists."
  expect tree has "add-name"
  tap "add-cancel"
  clock settle
  expect tree missing "name-2"

test "checking today starts a streak, survives a reload, and unchecking clears it"
  epoch "2026-03-14T18:00:00Z"
  time-zone "America/Los_Angeles"
  clock data
  tap "empty-add"
  clock settle
  type "add-name" "Read"
  tap "add-save"
  clock data
  clock settle
  expect tree missing "streak-1"
  tap "check-1"
  clock data
  expect text "streak-1" == "1-day streak"
  expect text "progress" == "1 of 1 done"
  reload
  clock data
  expect state habits.0.doneToday == true
  expect text "streak-1" == "1-day streak"
  expect text "progress" == "1 of 1 done"
  tap "check-1"
  clock data
  expect state habits.0.doneToday == false
  expect tree missing "streak-1"
  expect text "progress" == "0 of 1 done"

test "a streak stays alive a day, grows, then breaks after a missed day"
  epoch "2026-03-14T18:00:00Z"
  time-zone "America/Los_Angeles"
  clock data
  expect text "today-date" == "Mar 14, 2026"
  tap "empty-add"
  clock settle
  type "add-name" "Read"
  tap "add-save"
  clock data
  clock settle
  tap "check-1"
  clock data
  expect text "streak-1" == "1-day streak"
  clock + 86400000
  clock data
  expect text "today-date" == "Mar 15, 2026"
  expect text "streak-1" == "1-day streak"
  expect text "progress" == "0 of 1 done"
  tap "check-1"
  clock data
  expect text "streak-1" == "2-day streak"
  expect text "progress" == "1 of 1 done"
  clock + 172800000
  clock data
  expect text "today-date" == "Mar 17, 2026"
  expect tree missing "streak-1"
  tap "open-1"
  clock settle
  clock data
  expect text "detail-best" == "2 days"
  expect text "detail-total" == "2 days"
  expect text "detail-streak" == "Current Streak0days in a row"

test "the streak card reads the current streak, in step with checking and unchecking"
  epoch "2026-03-14T18:00:00Z"
  time-zone "America/Los_Angeles"
  clock data
  tap "empty-add"
  clock settle
  type "add-name" "Read"
  tap "add-save"
  clock data
  clock settle
  tap "check-1"
  clock data
  clock + 86400000
  clock data
  tap "check-1"
  clock data
  clock + 86400000
  clock data
  tap "check-1"
  clock data
  clock + 172800000
  clock data
  tap "check-1"
  clock data
  clock + 86400000
  clock data
  tap "check-1"
  clock data
  tap "open-1"
  clock settle
  clock data
  expect state habits.0.streak == 2
  expect state habits.0.best == 3
  expect text "detail-streak" == "Current Streak2days in a row"
  expect text "detail-best" == "3 days"
  expect text "detail-total" == "5 days"
  tap "detail-check"
  clock data
  expect text "detail-streak" == "Current Streak1day in a row"
  tap "detail-check"
  clock data
  expect text "detail-streak" == "Current Streak2days in a row"

test "the day turns over at local midnight"
  epoch "2026-03-15T06:58:00Z"
  time-zone "America/Los_Angeles"
  clock data
  expect text "today-date" == "Mar 14, 2026"
  tap "empty-add"
  clock settle
  type "add-name" "Read"
  tap "add-save"
  clock data
  clock settle
  tap "check-1"
  clock data
  expect text "progress" == "1 of 1 done"
  clock + 180000
  clock data
  expect text "today-date" == "Mar 15, 2026"
  expect text "progress" == "0 of 1 done"
  expect text "streak-1" == "1-day streak"

test "a habit opens its detail; delete asks, Cancel keeps it, Delete returns to an empty Today"
  clock data
  tap "empty-add"
  clock settle
  type "add-name" "Read"
  tap "add-save"
  clock data
  clock settle
  tap "open-1"
  clock settle
  expect text "detail-title" == "Read"
  tap "habit-menu"
  clock settle
  tap "delete-habit"
  clock settle
  tap "remove-cancel"
  clock settle
  expect text "detail-title" == "Read"
  tap "habit-menu"
  clock settle
  tap "delete-habit"
  clock settle
  tap "remove-confirm"
  clock settle
  clock data
  expect tree missing "detail-title"
  expect tree has "empty-add"
  expect tree missing "name-1"

test "the history marks today done once checked on the detail"
  epoch "2026-03-14T18:00:00Z"
  time-zone "America/Los_Angeles"
  clock data
  tap "empty-add"
  clock settle
  type "add-name" "Read"
  tap "add-save"
  clock data
  clock settle
  tap "open-1"
  clock settle
  clock data
  expect tree has "day-2026-03-14"
  expect tree has "day-2026-02-15"
  expect tree missing "future-2026-03-14"
  expect state days.27.done == false
  tap "detail-check"
  clock data
  expect state days.27.done == true
  expect text "detail-streak" == "Current Streak1day in a row"

test "midweek, the days after today are blank cells that keep the grid aligned"
  epoch "2026-03-11T18:00:00Z"
  time-zone "America/Los_Angeles"
  clock data
  tap "empty-add"
  clock settle
  type "add-name" "Read"
  tap "add-save"
  clock data
  clock settle
  tap "open-1"
  clock settle
  clock data
  expect tree has "day-2026-02-15"
  expect tree has "day-2026-03-11"
  expect tree has "future-2026-03-12"
  expect tree has "future-2026-03-14"
  expect tree missing "day-2026-03-12"
  expect tree missing "day-2026-03-14"
  expect state days.27.future == true
  expect state days.24.future == false
  expect state days.27.done == false

test "tapping a past day logs it, in step with the totals and the streak; tapping again clears it"
  epoch "2026-03-14T18:00:00Z"
  time-zone "America/Los_Angeles"
  clock data
  tap "empty-add"
  clock settle
  type "add-name" "Read"
  tap "add-save"
  clock data
  clock settle
  tap "open-1"
  clock settle
  clock data
  tap "day-2026-03-12"
  clock data
  expect state days.25.done == true
  expect text "detail-total" == "1 day"
  expect text "detail-best" == "1 day"
  expect text "detail-streak" == "Current Streak0days in a row"
  tap "day-2026-03-13"
  clock data
  expect text "detail-total" == "2 days"
  expect text "detail-streak" == "Current Streak2days in a row"
  tap "day-2026-03-14"
  clock data
  expect state days.27.done == true
  expect state habits.0.doneToday == true
  expect text "detail-streak" == "Current Streak3days in a row"
  tap "day-2026-03-13"
  clock data
  expect state days.26.done == false
  expect text "detail-total" == "2 days"
  expect text "detail-streak" == "Current Streak1day in a row"
  tap "day-2026-03-14"
  clock data
  expect state habits.0.doneToday == false
  expect text "detail-total" == "1 day"

test "today's cell, the Done Today switch and the history stay in step"
  epoch "2026-03-14T18:00:00Z"
  time-zone "America/Los_Angeles"
  clock data
  tap "empty-add"
  clock settle
  type "add-name" "Read"
  tap "add-save"
  clock data
  clock settle
  tap "open-1"
  clock settle
  clock data
  tap "day-2026-03-13"
  clock data
  tap "day-2026-03-14"
  clock data
  tap "detail-check"
  clock data
  tap "detail-check"
  clock data
  expect state days.27.done == true
  expect text "detail-streak" == "Current Streak2days in a row"

test "an id that names nothing says Not Found, and Back returns to Today"
  clock data
  type "app" "/habit/999"
  clock settle
  clock data
  expect text "detail-title" == "Not Found"
  expect tree missing "habit-menu"
  expect tree has "missing-back"
  tap "missing-back"
  clock settle
  expect tree has "add-habit"
  expect tree missing "missing-back"

test "the row's link says the habit and its streak to a screen reader"
  epoch "2026-03-14T18:00:00Z"
  time-zone "America/Los_Angeles"
  clock data
  tap "empty-add"
  clock settle
  type "add-name" "Read"
  tap "add-save"
  clock data
  clock settle
  tap "check-1"
  clock data
  tap "Details for Read, 1-day streak"
  clock settle
  clock data
  expect text "detail-title" == "Read"

test "tapping a suggestion on an empty Today adds that habit at once"
  clock data
  tap "quick-Read"
  clock data
  clock settle
  expect text "name-1" == "Read"
  expect text "progress" == "0 of 1 done"
  expect tree missing "quick-Read"
  expect tree missing "empty-add"

test "a suggestion with a space in its name adds too"
  clock data
  tap "quick-Drink Water"
  clock data
  clock settle
  expect text "name-1" == "Drink Water"

test "a suggestion in the add sheet fills the name without saving; once saved it is no longer offered"
  clock data
  tap "empty-add"
  clock settle
  expect tree has "suggest-Stretch"
  expect tree has "suggest-Read"
  tap "suggest-Stretch"
  expect state draftName == "Stretch"
  expect enabled "add-save"
  expect tree has "add-name"
  tap "add-save"
  clock data
  clock settle
  expect text "name-1" == "Stretch"
  tap "add-habit"
  clock settle
  expect tree has "suggest-Read"
  expect tree missing "suggest-Stretch"
  tap "add-cancel"
  clock settle

test "a suggestion is hidden when a habit has the name in any case"
  clock data
  tap "empty-add"
  clock settle
  type "add-name" "read"
  tap "add-save"
  clock data
  clock settle
  tap "add-habit"
  clock settle
  expect tree missing "suggest-Read"
  expect tree has "suggest-Walk"
  tap "add-cancel"
  clock settle

test "the pickers choose an icon and a colour; the row shows them; reopening resets them"
  clock data
  tap "empty-add"
  clock settle
  expect state draftIcon == "sparkles"
  expect state draftColor == "orange"
  tap "icon-picker"
  tap "icon-book"
  tap "color-picker"
  tap "color-blue"
  expect state draftIcon == "book"
  expect state draftColor == "blue"
  type "add-name" "Read"
  tap "add-save"
  clock data
  clock settle
  expect tree has "icon-1"
  expect state habits.0.icon == "book"
  expect state habits.0.color == "blue"
  tap "add-habit"
  clock settle
  expect state draftIcon == "sparkles"
  expect state draftColor == "orange"
  tap "add-cancel"
  clock settle

test "a duplicate refused keeps the picked icon and colour; a suggestion sets its icon"
  clock data
  tap "quick-Read"
  clock data
  clock settle
  expect state habits.0.icon == "book"
  expect state habits.0.color == "orange"
  tap "add-habit"
  clock settle
  tap "icon-picker"
  tap "icon-star"
  tap "color-picker"
  tap "color-teal"
  type "add-name" "read"
  tap "add-save"
  clock data
  expect text "add-error" == "A habit called Read already exists."
  expect state draftIcon == "star"
  expect state draftColor == "teal"
  tap "suggest-Meditate"
  expect state draftIcon == "moon"
  expect state draftColor == "teal"
  tap "add-cancel"
  clock settle

test "quick-adding a suggestion stores its icon with the default colour"
  clock data
  tap "quick-Stretch"
  clock data
  clock settle
  expect state habits.0.icon == "running"
  expect state habits.0.color == "orange"

test "the habit screen shows the habit's icon"
  clock data
  tap "quick-Meditate"
  clock data
  clock settle
  tap "open-1"
  clock settle
  expect tree has "detail-icon"
