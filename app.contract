// Habits: a daily habit tracker. app.ts keeps habits and check-ins in SQLite.
// SEAM (fixed by SPEC.md): routes, shapes, resources, mutations and the actions below
// keep their names and signatures. The view is free to change; it must keep SPEC.md's testIds.
use Badge, DoneMark, EmptyState, SummaryCard from "exact:content"

routes nav
  today "/"
    habit "/habit/:id"
    add "/add"

shape Time
  epochAtZero: number
  utcOffset: number

shape Habit
  id: string
  name: string
  doneToday: bool
  streak: number
  best: number
  total: number

shape DayMark
  day: string
  done: bool
  future: bool

shape Reply
  ok: bool
  error: string

fn dayCount(n: number): string = n == 1 ? "1 day" : `${n} days`
fn streakText(n: number): string = n == 0 ? "No streak" : `${n}-day streak`
fn rowLabel(h: Habit): string = h.streak > 0 ? `Details for ${h.name}, ${streakText(h.streak)}` : `Details for ${h.name}`
fn nameOf(hs: Habit[], id: string): string = match first(hs.filter(h => h.id == id)) { case some(h) => h.name, case none => "" }
fn dayOfMonth(day: string): string = day.slice(8).startsWith("0") ? day.slice(9) : day.slice(8)
fn dayLabel(d: DayMark): string = `${formatDate(d.day, 0, "month-day")}, ${d.done ? "done" : "not done"}`
fn found(hs: Habit[], id: string): bool = hs.filter(h => h.id == id).length > 0
fn suggestions(): string[] = ["Read", "Drink Water", "Stretch", "Meditate", "Walk", "Journal"]
fn taken(hs: Habit[], name: string): bool = hs.filter(h => h.name.toLowerCase() == name.toLowerCase()).length > 0

component Habits
  state now = 0
  state draftName = ""
  state refusal = ""
  state aimed = ""
  resource time = exactTime() as shape Time
  derive shown = time.epochAtZero + now
  derive today = formatDate(shown, time.utcOffset, "iso")
  derive selected = match stack(nav).filter(e => e.name == "habit").at(-1) { case some(e) => e.params.id, case none => "" }
  resource habits = loadHabits(today) as shape Habit[] else empty()
  resource days = loadDays(selected, today) when selected != "" as shape DayMark[] else empty()
  mutation added as shape Reply refreshes habits then afterSave
  mutation checked as shape Reply queue refreshes habits, days
  mutation removed as shape Reply refreshes habits
  derive doneCount = habits.filter(h => h.doneToday).length
  derive offered = suggestions().filter(s => not taken(habits, s))
  derive saveError = match added { case some(r) => r.error, case none => "" }
  derive saveHint = pending(added) ? "Saving…" : draftName.trim() == "" ? "Enter a name to save." : ""

  task tick mount
    every(60000, step)
  action step
    now = performanceNow()

  action back
    nav = back(nav)
  action follow(url: string)
    nav = top(nav).name == "habit" and url.startsWith("/habit/") ? replace(nav, url) : go(nav, url)
  action openAdd
    draftName = ""
    refusal = ""
    nav = push(nav, "/add")
  action editName(v: string)
    draftName = v
  action save
    if draftName.trim() != "" and not pending(added)
      send added = addHabit(draftName.trim())
  action quickAdd(name: string)
    if not pending(added)
      send added = addHabit(name)
  action afterSave
    refusal = saveError
    if saveError == "" and top(nav).name == "add"
      nav = back(nav)
  // The day is read from the clock at the tap, not from the ticked `today` (dates-and-days).
  action toggle(id: string, done: bool)
    let at = time.epochAtZero + performanceNow()
    now = performanceNow()
    send checked = setDone(id, formatDate(at, time.utcOffset, "iso"), done)
  action toggleDay(id: string, day: string, done: bool)
    send checked = setDone(id, day, done)
  action askRemove(id: string)
    aimed = id
    showModal("remove")
  action remove(id: string)
    send removed = removeHabit(id)
    if selected == id
      nav = back(nav)

  derive fraction = habits.length == 0 ? 0 : doneCount / habits.length
  action reload
    refresh habits

  view
    main navigationKey=`${top(nav).id}` navigationBack="back" navigate=follow testId="app" width="100%" height="100%"
      for e in stack(nav) key=e.id
        if e.name == "today"
          column navigationKey=`${e.id}` navigationSplit="split" navigationScroll="habit-list" position="absolute" inset=0 display="flex" flex-direction="column"
            header display="flex" align-items="center"
              text "Today" role="heading" aria-level=1 flex=1
              text formatDate(shown, time.utcOffset, "medium") testId="today-date"
              button press=openAdd aria-label="Add Habit" testId="add-habit"
                image "symbol:add"
            if failed(habits)
              EmptyState(symbol="symbol:alert", title="Can’t Open Habits", message="Something went wrong reading them.")
                button press=reload testId="retry"
                  text "Try Again"
            else if habits.length == 0 and not pending(habits)
              EmptyState(symbol="symbol:sparkles", title="Start a Habit", message="Pick one to begin, or add your own.")
                column gap=8
                  for s in suggestions() key=s
                    button press=quickAdd(s) buttonStyle="bordered" min-height=44 aria-label=`Add ${s}` testId=`quick-${s}`
                      text s
                  button press=openAdd buttonStyle="filled" min-height=44 testId="empty-add"
                    text "Add Habit"
            else
              list id="habit-list" appearance="auto" listStyle="inset-grouped" flex=1 min-height=0
                if habits.length > 0
                  section
                    // One line over a thin native bar, stacked: side by side, a Mac sidebar squeezed the text to a letter a line.
                    column gap=6
                      text `${doneCount} of ${habits.length} done` color="-exact-secondary-label" testId="progress"
                      progress value=fraction aria-label="Today’s progress" testId="progress-bar"
                section
                  for h in habits key=h.id
                    row delete=remove(h.id)
                      input type="checkbox" checked=h.doneToday change=toggle(h.id) aria-label=h.name testId=`check-${h.id}`
                      // The name and streak are the link to the detail, as a row pushes; the checkbox stays apart.
                      // Done is the checkbox's to say; the strike-through is decoration. The streak reaches a screen reader through the link's label.
                      link href=path("habit", h.id) aria-label=rowLabel(h) testId=`open-${h.id}`
                        flex=1 min-width=0 min-height=44 display="flex" flex-wrap="wrap" align-items="center" gap=8
                        text h.name flex=1 text-decoration=(h.doneToday ? "line-through" : "none") color=(h.doneToday ? "-exact-secondary-label" : "-exact-label") testId=`name-${h.id}`
                        if h.streak > 0
                          view testId=`streak-${h.id}`
                            Badge(label=streakText(h.streak), tint=some("-exact-system-orange"))
                        image "symbol:forward-chevron" aria-hidden=true
            // The split's detail while no habit is selected (a wide window): ours, not the platform's "No Selection".
            column navigationSplit="placeholder" min-height=0
              EmptyState(symbol="symbol:sparkles", title="Select a Habit", message="Its streak and history show here.")
        if e.name == "habit"
          column navigationKey=`${e.id}` navigationScroll="habit-detail" position="absolute" inset=0 display="flex" flex-direction="column"
            header display="flex" align-items="center" justify-content="space-between"
              text (found(habits, e.params.id) or pending(habits) ? nameOf(habits, e.params.id) : "Not Found") role="heading" aria-level=2 testId="detail-title"
              if found(habits, e.params.id)
                button popovertarget="habit-menu" aria-label="More" testId="habit-menu"
                  image "symbol:more"
            if found(habits, e.params.id)
              column id="habit-menu" popover="auto" role="menu" aria-label="Habit"
                button press=askRemove(e.params.id) destructive=true popovertarget="habit-menu" popovertargetaction="hide" testId="delete-habit"
                  text "Delete Habit"
            if found(habits, e.params.id) or pending(habits)
              list id="habit-detail" appearance="auto" listStyle="inset-grouped" flex=1 min-height=0
                for h in habits.filter(x => x.id == e.params.id) key=h.id
                  // The hero: the current streak over its progress toward the best, in a transparent section so the part's own fill shows, centred and at most a phone wide.
                  section background-color="transparent"
                    row
                      column flex=1 min-width=0 max-width="26.25rem" margin-left="auto" margin-right="auto" testId="detail-streak"
                        SummaryCard(label="Current Streak", value=`${h.streak}`, detail=(h.streak == 1 ? "day in a row" : "days in a row"), progress=(h.best > 0 ? some(min(1, h.streak / h.best)) : none), symbol=none)
                  section
                    row
                      text "Done Today" flex=1
                      input type="checkbox" switch checked=h.doneToday change=toggle(h.id) aria-label="Done Today" testId="detail-check"
                  section
                    row
                      text "Best" flex=1
                      text dayCount(h.best) testId="detail-best"
                    row
                      text "Total" flex=1
                      text dayCount(h.total) testId="detail-total"
                  section
                    header
                      text "Last 4 Weeks"
                    row padding-top=8 padding-bottom=8 testId="history"
                      column flex=1 min-width=0 gap=8
                        row aria-hidden=true
                          for n in ["S", "M", "T", "W", "T", "F", "S"] key=n
                            text n flex=1 min-width=0 text-align="center" font="-exact-footnote" color="-exact-secondary-label"
                        for w in [0, 1, 2, 3] key=w
                          row
                            for d in days.slice(w * 7, w * 7 + 7) key=d.day
                              if d.future
                                view flex=1 min-width=0 aria-hidden=true testId=`future-${d.day}`
                              else
                                // Today's tint sits on a view around the button: a radius or fill on the button itself would paint a platform control.
                                view flex=1 min-width=0 border-radius=8 background-color=(d.day == today ? "-exact-tertiary-fill" : "transparent")
                                  button press=toggleDay(e.params.id, d.day, not d.done) width="100%" min-height=44 aria-current=(d.day == today ? "date" : "") aria-label=dayLabel(d) testId=`day-${d.day}`
                                    DoneMark(caption=dayOfMonth(d.day), done=d.done)
            else
              EmptyState(symbol="symbol:alert", title="No Such Habit", message="It may have been deleted.")
                button press=back buttonStyle="filled" testId="missing-back"
                  text "Back to Today"
        if e.name == "add"
          column navigationKey=`${e.id}` navigationPresentation="modal" navigationScroll="add-form" position="absolute" inset=0 display="flex" flex-direction="column"
            header display="flex" align-items="center" justify-content="space-between"
              button id="back" press=back aria-label="Cancel" testId="add-cancel"
                image "symbol:close"
              text "New Habit" role="heading"
              button press=save buttonStyle="bordered-prominent" aria-label="Save" testId="add-save" disabled=(draftName.trim() == "" or pending(added))
                image "symbol:checkmark"
            list id="add-form" appearance="auto" listStyle="inset-grouped" flex=1 min-height=0
              section
                row
                  column flex=1 min-width=0 gap=4
                    input value=draftName input=editName submit=save placeholder="Name" aria-label="Name" autofocus=true aria-invalid=(refusal != "") testId="add-name"
                    if refusal != ""
                      text refusal font="-exact-footnote" color="-exact-system-red" testId="add-error"
                footer
                  text saveHint testId="add-hint"
              if offered.length > 0
                section
                  header
                    text "Suggestions"
                  for s in offered key=s
                    row
                      button press=editName(s) aria-label=`Use ${s}` testId=`suggest-${s}`
                        text s
      dialog id="remove" role="alertdialog" aria-label="Delete Habit?"
        text "Its history is deleted too."
        button press=remove(aimed) destructive=true commandfor="remove" command="close" testId="remove-confirm"
          text "Delete"
        button commandfor="remove" command="close" testId="remove-cancel"
          text "Cancel"
